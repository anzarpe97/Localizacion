<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- FORM VIEW (res.users) -->
    <record id="res_user_form_inherit" model="ir.ui.view">
        <field name="name">res.users.form.view.inherit</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form" />
        <field name="arch" type="xml">
            <!-- Campos despues de login -->
            <xpath expr="//field[@name='login']" position="after">
                <label string="Profiles" for="access_profile_line_ids" />
                <field name="access_profile_line_ids" widget="many2many_tags" options="{'no_create': True}" groups="base.group_system" required="not access_admin_user" />
                <field name="access_password_expire_date" invisible="1" />
                <field name="access_admin_user" invisible="1" force_save="1" />
            </xpath>
            <!-- Botón en el button box -->
            <xpath expr="//div[contains(@class,'oe_button_box')]//button[@name='action_show_groups']" position="before">
                <button name="access_action_create_profile" string="Create Profile" type="object" class="oe_stat_button" icon="fa-users" groups="base.group_system" />
            </xpath>
            <!-- Pestañas extra -->
            <xpath expr="//notebook" position="inside">
                <page string="Profile manager" groups="base.group_system">
                    <field name="access_user_manager_id">
                        <tree>
                            <field name="name" />
                        </tree>
                    </field>
                </page>
                <page string="Recent Activity">
                    <field name="access_recent_activity_line">
                        <tree editable="top" default_order="access_login_date desc">
                            <!-- OJO: estos campos deben existir en el COMODEL -->
                            <field name="access_user_id" />
                            <field name="access_login_date" />
                            <field name="access_logout_date" />
                            <field name="access_duration" />
                            <field name="access_status" string="Estado" />
                            <button name="access_action_logout" string="Cerrar Sesión" type="object" invisible="access_status == 'close'" groups="base.group_system" />
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
    <!-- LIST VIEW (res.users) -->
    <record id="res_user_tree_inherit" model="ir.ui.view">
        <field name="name">res.users.list.inherit</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='login']" position="after">
                <field name="access_profile_line_ids" string="Perfil de Usuario" widget="many2many_tags" groups="base.group_system" />
                <field name="access_password_expire_date" groups="base.group_system" />
                <field name="access_password_update" />
                <field name="access_is_passwd_expired" invisible="1" />
                <field name="access_admin_user" invisible="1" />
            </xpath>
            <xpath expr="//field[@name='state']" position="after">
                <button name="access_action_login_confirm" string="Acceso" type="object" groups="base.group_system" />
            </xpath>
        </field>
    </record>
    <!-- SEARCH VIEW (res.users) -->
    <record id="res_users_search_inherit" model="ir.ui.view">
        <field name="name">res.users.search.inherit</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_search" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='company_ids']" position="after">
                <field name="access_profile_ids" string="Perfil" widget="many2many_tags" groups="base.group_system" />
            </xpath>
        </field>
    </record>
</odoo>